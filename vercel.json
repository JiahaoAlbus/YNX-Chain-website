{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/apps", "destination": "/dapp", "permanent": true },
    { "source": "/download", "destination": "/dapp/download", "permanent": true },
    { "source": "/faucet", "destination": "/dapp/faucet", "permanent": true },
    { "source": "/square", "destination": "/dapp/square", "permanent": true },
    { "source": "/square/:path*", "destination": "/dapp/square/:path*", "permanent": true },
    { "source": "/wallet", "destination": "/dapp/wallet", "permanent": true },
    { "source": "/social", "destination": "/dapp/social", "permanent": true },
    { "source": "/pay", "destination": "/dapp/pay", "permanent": true },
    { "source": "/merchant", "destination": "/dapp/merchant", "permanent": true },
    { "source": "/card", "destination": "/dapp/card", "permanent": true },
    { "source": "/exchange", "destination": "/dapp/exchange", "permanent": true },
    { "source": "/quant", "destination": "/dapp/quant", "permanent": true },
    { "source": "/shop", "destination": "/dapp/shop", "permanent": true },
    { "source": "/seller", "destination": "/dapp/seller", "permanent": true },
    { "source": "/developer", "destination": "/dapp/developer", "permanent": true },
    { "source": "/explorer", "destination": "/dapp/explorer", "permanent": true },
    { "source": "/monitor", "destination": "/dapp/monitor", "permanent": true },
    { "source": "/ai", "destination": "/dapp/ai", "permanent": true },
    { "source": "/trust", "destination": "/dapp/trust", "permanent": true },
    { "source": "/resource", "destination": "/dapp/resource", "permanent": true },
    { "source": "/music", "destination": "/dapp/music", "permanent": true },
    { "source": "/video", "destination": "/dapp/video", "permanent": true },
    { "source": "/creator", "destination": "/dapp/creator", "permanent": true },
    { "source": "/cloud", "destination": "/dapp/cloud", "permanent": true },
    { "source": "/docs-app", "destination": "/dapp/docs-app", "permanent": true },
    { "source": "/browser", "destination": "/dapp/browser", "permanent": true },
    { "source": "/search", "destination": "/dapp/search", "permanent": true },
    { "source": "/finance", "destination": "/dapp/finance", "permanent": true },
    { "source": "/mail", "destination": "/dapp/mail", "permanent": true },
    { "source": "/calendar", "destination": "/dapp/calendar", "permanent": true },
    { "source": "/dex", "destination": "/dapp/dex", "permanent": true }
  ],
  "headers": [
    {
      "source": "/downloads/wallet-web/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/downloads/wallet/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    },
    {
      "source": "/releases/exchange/fc2276e1ce4c/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/docs-authority/packages/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.ynxweb4.com https://faucet.ynxweb4.com; manifest-src 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/downloads/wallet/sha256-8cf24d83dd5da5851484eab14ce9e6cd16946c95699a7af1e11048bbd7692bea/ynx-wallet-desktop-0.1.0-x86_64.rpm", "destination": "https://dyggjsbxsiew8l6u.public.blob.vercel-storage.com/downloads/wallet/sha256-8cf24d83dd5da5851484eab14ce9e6cd16946c95699a7af1e11048bbd7692bea/ynx-wallet-desktop-0.1.0-x86_64.rpm" },
