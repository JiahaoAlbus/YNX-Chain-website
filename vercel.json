    { "source": "/downloads/ynx-trust-center-4d40557229b4-linux-amd64.tar.gz", "destination": "https://dyggjsbxsiew8l6u.public.blob.vercel-storage.com/downloads/ynx-trust-center-4d40557229b4-linux-amd64.tar.gz" },
    { "source": "/downloads/ynx-shop-0.3.0-testnet-preview-6fa2d6c5-debug-signed.apk", "destination": "https://dyggjsbxsiew8l6u.public.blob.vercel-storage.com/downloads/ynx-shop-0.3.0-testnet-preview-6fa2d6c5-debug-signed.apk" },
    { "source": "/downloads/ynx-wallet-1.0.0-testnet-preview-ae8771c-test-signed.apk", "destination": "https://dyggjsbxsiew8l6u.public.blob.vercel-storage.com/downloads/ynx-wallet-1.0.0-testnet-preview-ae8771c-test-signed.apk" },
    { "source": "/downloads/ynx-wallet-1.0.0-testnet-preview-ccaf878c-test-signed.apk", "destination": "https://dyggjsbxsiew8l6u.public.blob.vercel-storage.com/downloads/ynx-wallet-1.0.0-testnet-preview-ccaf878c-test-signed-gwrQJydXGTCeQfwpnIUokylkukF8CD.apk" },
    { "source": "/downloads/ynx-exchange-1.0.0-testnet-preview-1e5f48d2-test-signed.apk", "destination": "https://dyggjsbxsiew8l6u.public.blob.vercel-storage.com/downloads/ynx-exchange-1.0.0-testnet-preview-1e5f48d2-test-signed.apk" },
    { "source": "/downloads/ynx-finance-1.2.0-testnet-preview-307273b9-test-signed.apk", "destination": "https://dyggjsbxsiew8l6u.public.blob.vercel-storage.com/downloads/ynx-finance-1.2.0-testnet-preview-307273b9-test-signed-8WRdkqJCJnHBCsuyDsRj4XjEreyeYT.apk" },
    { "source": "/downloads/ynx-social-1.0.0-testnet-preview-aa852496-test-signed.apk", "destination": "https://dyggjsbxsiew8l6u.public.blob.vercel-storage.com/downloads/ynx-social-1.0.0-testnet-preview-aa852496-test-signed-15JR16t0lzmvyKU06tyaYXcUGC0sjQ.apk" },
