downloads.ynxweb4.com {
	root * /opt/ynx/public-downloads

	@diskImages path *.dmg
	header @diskImages Content-Type application/x-apple-diskimage
	header @diskImages Content-Disposition "attachment"
	header X-Content-Type-Options nosniff
	header Cache-Control "public, max-age=31536000, immutable"

	file_server
}
